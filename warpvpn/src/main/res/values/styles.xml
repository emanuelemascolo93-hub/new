<resources>
    <style name="AppTheme" parent="Theme.AppCompat.NoActionBar">
        <item name="android:windowBackground">#0E0F14</item>
        <item name="android:textColorPrimary">#F2F2F2</item>
        <item name="colorAccent">#F6821F</item>
        <item name="colorPrimary">#F6821F</item>
        <item name="android:windowFullscreen">true</item>
    </style>
    <style name="TvButton" parent="Widget.AppCompat.Button">
        <item name="android:background">@drawable/focus_bg</item>
        <item name="android:textColor">#F2F2F2</item>
        <item name="android:padding">14dp</item>
        <item name="android:textSize">16sp</item>
        <item name="android:focusable">true</item>
    </style>
</resources>
