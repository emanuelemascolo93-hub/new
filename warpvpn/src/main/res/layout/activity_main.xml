<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:gravity="center"
    android:padding="48dp">

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/app_name"
        android:textSize="34sp"
        android:textStyle="bold"
        android:textColor="#F6821F" />

    <TextView
        android:id="@+id/status"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="24dp"
        android:text="@string/status_down"
        android:textSize="20sp"
        android:textColor="#F2F2F2" />

    <TextView
        android:id="@+id/detail"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:textSize="14sp"
        android:textColor="#A0A4B0" />

    <LinearLayout
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="40dp"
        android:orientation="horizontal">

        <Button android:id="@+id/btnConnect" style="@style/TvButton"
            android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:layout_marginEnd="12dp" android:text="@string/connect" />

        <Button android:id="@+id/btnDisconnect" style="@style/TvButton"
            android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:layout_marginEnd="12dp" android:text="@string/disconnect" />

        <Button android:id="@+id/btnNext" style="@style/TvButton"
            android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:layout_marginEnd="12dp" android:text="@string/next_endpoint" />

        <Button android:id="@+id/btnBench" style="@style/TvButton"
            android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:layout_marginEnd="12dp" android:text="@string/bench" />

        <Button android:id="@+id/btnReset" style="@style/TvButton"
            android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:text="@string/reset" />
    </LinearLayout>

    <TextView
        android:id="@+id/report"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="28dp"
        android:typeface="monospace"
        android:textSize="14sp"
        android:textColor="#A0A4B0" />
</LinearLayout>
